  "info": {
    "description": "Cricket intelligence, ball by ball. Model outputs are estimates, not guarantees of real outcomes.",
    "title": "CricIQ API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/matches": {
      "get": {
        "description": "Paginated match summaries, newest first by default.",
        "operationId": "list_matches_api_v1_matches_get",
        "parameters": [
          {
            "in": "query",
            "name": "season",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 2100,
                  "minimum": 2008,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Season"
            }
          },
          {
            "description": "Franchise id, e.g. MI",
            "in": "query",
            "name": "team",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 8,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Franchise id, e.g. MI",
              "title": "Team"
            }
          },
          {
            "description": "Venue id",
            "in": "query",
            "name": "venue",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 64,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Venue id",
              "title": "Venue"
            }
          },
          {
            "description": "Only playoffs (true) or league",
            "in": "query",
            "name": "playoffs",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only playoffs (true) or league",
              "title": "Playoffs"
            }
          },
          {
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "default": "latest",
              "enum": [
                "latest",
                "oldest"
              ],
              "title": "Sort",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "minimum": 1,
              "title": "Page",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "page_size",
            "required": false,
            "schema": {
              "default": 24,
              "maximum": 100,
              "minimum": 1,
              "title": "Page Size",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MatchPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Matches",
        "tags": [
          "matches"
        ]
      }
    },
    "/api/v1/matches/{match_id}": {
      "get": {
        "description": "Match summary with full scorecards for every innings.",
        "operationId": "read_match_api_v1_matches__match_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "match_id",
            "required": true,
            "schema": {
              "title": "Match Id",
              "type": "integer"
            }
